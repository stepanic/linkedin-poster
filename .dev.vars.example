# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# In production these go in with `wrangler secret put <NAME>`.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Bearer token for POST /post and /mcp. Generate: openssl rand -hex 32
API_TOKEN=
# Guards GET /auth/start so nobody else can bind their LinkedIn account to
# your Worker. Generate: openssl rand -hex 32
SETUP_KEY=
# Optional. Any URL that accepts a JSON POST. Used only when Telegram is not
# configured, and kept for anything that already points at it.
NOTIFY_WEBHOOK=
# Telegram notifications. Create the bot with @BotFather, then read the group's
# id from /telegram/chatid?key=<SETUP_KEY>. See docs/2026-08-27-telegram-obavijesti.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
