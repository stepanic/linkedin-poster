{
  "name": "linkedin-poster",
  "version": "1.0.0",
  "private": false,
  "description": "Post to your own LinkedIn feed from Claude Code or curl — a Cloudflare Worker with an MCP server, an HTTP API and a voice linter",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail",
    "test:telegram": "node --experimental-strip-types scripts/test-telegram.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "wrangler": "^4.96.0"
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
